{
  "name": "ahadiff-viewer",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-initial-js-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real-serve": "playwright test -c playwright.real-serve.config.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.29.1",
    "react-router-dom": "^7.18.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 121",
    "safari >= 16.4",
    "ios >= 16.4"
  ],
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <7.29.4": "^7.29.4",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "serialize-javascript@>=7.0.0 <7.0.5": "^7.0.5"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
